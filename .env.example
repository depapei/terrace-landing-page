# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by the app.
# On Vercel + Supabase use the transaction pooler (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/terrace?schema=public"
# Optional: connection for the Prisma CLI (migrate, seed, studio). Supabase: session pooler (port 5432).
# Falls back to DATABASE_URL when empty.
DIRECT_URL=""

# Public site URL (metadata, Open Graph, CSRF origin allow-list)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Verified contact channels. Leave empty to hide them on the site.
NEXT_PUBLIC_CONTACT_EMAIL=""
# Digits only, with country code, e.g. 6281234567890
# Enables both direct WhatsApp and continuation after a saved inquiry.
# If unset, inquiries can still be saved, but no WhatsApp link is shown.
NEXT_PUBLIC_CONTACT_WHATSAPP=""

# Seeder (optional). Defaults to username "admin" and the initial password from
# the project brief. Set a strong value for any internet-facing environment.
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""
# "true" re-hashes the seed password for an existing admin and revokes sessions.
SEED_ADMIN_RESET_PASSWORD="false"

# Image storage: "local" (default, development) or "s3"
STORAGE_DRIVER="local"
# Local driver directory (default: ./storage/uploads). Not persistent on serverless hosts.
LOCAL_STORAGE_DIR=""

# S3-compatible storage (Supabase Storage, AWS S3, Cloudflare R2, MinIO). Required when STORAGE_DRIVER=s3.
# Supabase: S3_ENDPOINT="https://<ref>.storage.supabase.co/storage/v1/s3", S3_FORCE_PATH_STYLE="true",
#           S3_PUBLIC_BASE_URL="https://<ref>.supabase.co/storage/v1/object/public/<bucket>"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
# Public base URL that serves the bucket objects, e.g. https://cdn.example.com
S3_PUBLIC_BASE_URL=""
